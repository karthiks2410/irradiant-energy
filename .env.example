# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase (public, safe in client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: GITHUB_PAT is NOT set here. .mcp.json reads it from your shell
# environment, so it must be exported before launching Claude Code:
#   echo 'export GITHUB_PAT=github_pat_...' >> ~/.zshrc && source ~/.zshrc
