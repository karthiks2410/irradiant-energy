# Copy to .env.local and fill in. .env.local is gitignored. Never commit real values.

# --- Public (safe in the client bundle) ---
# Canonical origin. Leave unset on previews and locally; in Production it must be exactly
# https://www.irradiantenergy.in (the www host, no trailing slash: the bare domain redirects to it).
# It also switches search-engine indexing on (src/lib/env.ts). A Production build fails without it.
NEXT_PUBLIC_SITE_URL=

# Google (src/lib/analytics.ts). Each is off until set; redeploy after setting, values are baked in at build.
# Search Console, HTML-tag method: only the content="…" value of the <meta> tag Google shows.
# (HTML-file method instead: put the google….html file Google gives you into public/ unchanged.)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 web stream measurement ID, G-XXXXXXXXXX. Loads in Production only, and only
# for a visitor who accepts analytics in the consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Local testing only: 1 lets Google Analytics load outside Production. Never set this in Vercel.
NEXT_PUBLIC_GA_ALLOW_NON_PRODUCTION=

# --- Server-only. Never prefix with NEXT_PUBLIC_. ---
# Resend (transactional email for quote requests). Set the values in Vercel → Project → Settings → Environment Variables.
# This business has its OWN Resend account (D-011). Sending only works once irradiantenergy.in is
# verified there (DKIM + a single combined SPF record alongside Google Workspace) — see docs/decisions.md.
RESEND_API_KEY=
# Sender and lead-alert recipient (decisions.md D-009). Move to the new domain once it is verified in Resend.
EMAIL_FROM=do-not-reply@irradiantenergy.in
LEAD_EMAIL=leads@irradiantenergy.in
